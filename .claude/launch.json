{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dev-maplibre",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "cf-worker",
      "runtimeExecutable": "node_modules/.bin/wrangler",
      "runtimeArgs": [
        "dev",
        "--port",
        "8787",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8787
    },
    {
      "name": "api-worker",
      "runtimeExecutable": "node_modules/.bin/wrangler",
      "runtimeArgs": [
        "dev",
        "-c",
        "api/wrangler.jsonc",
        "--port",
        "8790",
        "--ip",
        "127.0.0.1"
      ],
      "port": 8790
    }
  ]
}
